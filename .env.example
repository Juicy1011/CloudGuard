# CloudGuard Environment Configuration Template
DATABASE_URL=postgresql://cloudguard:cloudguard_password@localhost:5440/cloudguard
SECRET_KEY=change-me-to-a-secure-secret-key
ENCRYPTION_KEY=change-me-to-a-fernet-encryption-key
DEMO_MODE=true

# SMTP Email Alert Credentials (Optional for local testing)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
ALERT_RECEIVER=admin@cloudguard.local
